AZURE_OPENAI_ENDPOINT=your-endpoint-here
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Leave unset for gpt-5 (accept default only)
# LLM_TEMPERATURE=0

# Reasoning effort for the Data Retriever only; the Report Generator keeps the
# model default. Raise to low/medium if the retriever starts skipping searches,
# or set empty for models that reject the parameter.
# RETRIEVER_REASONING_EFFORT=minimal
